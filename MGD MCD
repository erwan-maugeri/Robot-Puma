K = 0.5  # gain 

dt=0.01
t=0

R=d1+d2+d3

distance=0

epsilon=0.1

prev_x, prev_y, prev_z = None, None, None

if dist > R:

    raise SystemExit(" Position impossible")
else:

    for i in range(10000):
        x,y,z=MGD(q1,q2,q3) #position actuelle
