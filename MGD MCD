        else:



            #vitesse outil
            v = K * e

            print("VITESSE =", v)


            Jmat = J(q1, q2, q3)

            dq = np.linalg.pinv(Jmat) @ v  #inverse de Jmat * v

            print("dq =", dq)
    
            #mise à jour des angles
            q1 +=dq[0]*dt
            q2 += dq[1]*dt
            q3 += dq[2]*dt

            if prev_x is not None:
                step = np.sqrt(
                    (x-prev_x)**2 + 
                    (y-prev_y)**2 +
                    (z - prev_z)**2
                )
                print("step",step)
                distance +=step

            t+=dt
            prev_x,prev_y,prev_z=x,y,z

