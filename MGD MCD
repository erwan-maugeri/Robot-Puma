#MGD

import numpy as np

d1 = 100 #buste
d2 = 80 #bras
d3 = 50 #avant-bras


def DH(theta, d, a, alpha):
    ct, st = np.cos(theta), np.sin(theta)
    ca, sa = np.cos(alpha), np.sin(alpha)
    return np.array([
        [ct, -st*ca,  st*sa, a*ct],
        [st,  ct*ca, -ct*sa, a*st],
        [ 0,     sa,     ca,    d],
        [ 0,      0,      0,    1]
    ])


def MGD(q1, q2, q3):
    
    T01 = DH(q1,d1,0,np.pi/2)
    T12 = DH(q2,0, d2,  0)
    T23 = DH(q3,0,d3,0)

    T03 = T01 @ T12 @ T23
    return T03[:3, 3]

q1 = np.deg2rad(0)
q2 = np.deg2rad(0)
q3 = np.deg2rad(90)

p=MGD(q1,q2,q3)

print(p)


#MCD

import numpy as np

def J(q1, q2, q3):

    r = d2*np.cos(q2) + d3*np.cos(q2+q3)

    J = np.array([

        [-r*np.sin(q1),
         (-d2*np.sin(q2) - d3*np.sin(q2+q3))*np.cos(q1),
         -d3*np.sin(q2+q3)*np.cos(q1)],

        [r*np.cos(q1),
         (-d2*np.sin(q2) - d3*np.sin(q2+q3))*np.sin(q1),
         -d3*np.sin(q2+q3)*np.sin(q1)],

        [0,
         d2*np.cos(q2) + d3*np.cos(q2+q3),
         d3*np.cos(q2+q3)]
    ])

    return J

